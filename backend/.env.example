# Copy this file to .env and fill in real values:  Copy-Item .env.example .env
# Generate a secret key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Single quotes = the value is taken literally (special characters like $ and # are safe).

DJANGO_SECRET_KEY='replace-me-with-a-generated-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (the Docker container). Must match POSTGRES_* in the root .env.
DB_NAME=shoplite
DB_USER=shoplite
DB_PASSWORD='change-me'
DB_HOST=localhost
DB_PORT=5433

# JWT (JSON Web Token) lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS: websites (origins) allowed to call the API from the browser. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery: where background jobs wait (Redis in Docker, reached from Windows via localhost).
CELERY_BROKER_URL=redis://localhost:6379/0

# Email: the console backend prints emails instead of sending them (development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ShopLite <orders@shoplite.local>
# The shop's currency (emails and payments). Keep it the same as VITE_CURRENCY in frontend/.env.
SHOP_CURRENCY=INR

# Razorpay payments. Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# Test keys start with rzp_test_ and move no real money. Leave empty to switch online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook in the Razorpay Dashboard (Test mode -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Links in emails point to this frontend address. Password reset links work for this many seconds.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600

# ---------------------------------------------------------------------------
# PRODUCTION ONLY (a real server with HTTPS). Leave commented out on your laptop.
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.shoplite.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.shoplite.example
# CORS_ALLOWED_ORIGINS=https://shoplite.example
# DJANGO_SECURE_HSTS_SECONDS=3600
# Real email through a mail provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD='...'
# EMAIL_USE_TLS=True
#
# On AWS (CloudFront -> load balancer -> ECS). On AWS these come from the ECS task
# definition and SSM Parameter Store, not from a .env file.
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_CLOUDFRONT_FORWARDED_PROTO   # how Django learns the visitor used HTTPS
# DB_SSLMODE=require              # encrypted connection to RDS
# DB_CONN_MAX_AGE=60              # reuse database connections for 60 seconds
# AWS_STORAGE_BUCKET_NAME=shoplite-demo-media-...   # uploads go to this S3 bucket instead of the disk
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=dxxxx.cloudfront.net          # upload links point at CloudFront
# DJANGO_LOG_LEVEL=INFO           # our own log messages (Django's own: errors only)
