# Copy this file to .env and fill in real values:  Copy-Item .env.example .env
# Generate a secret key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Single quotes = the value is taken literally (special characters like $ and # are safe).

DJANGO_SECRET_KEY='replace-me-with-a-generated-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
