# Copy this file to .env:  Copy-Item .env.example .env
# Only variables starting with VITE_ are visible to the frontend code.
# Never put secrets here: everything in the frontend is readable by anyone who opens the shop.

# Address of the Django API
VITE_API_URL=http://127.0.0.1:8000/api

# Currency used to show prices (a 3-letter code such as USD, EUR, GBP, INR)
VITE_CURRENCY=USD
