# Copy this file to .env and fill in real values.
# Docker Compose reads .env automatically and substitutes ${VARIABLES} in docker-compose.yml.

POSTGRES_DB=shoplite
POSTGRES_USER=shoplite
POSTGRES_PASSWORD=change-me

# Port on Windows that forwards to Postgres inside the container.
# 5433 because a native Windows PostgreSQL already uses 5432.
POSTGRES_HOST_PORT=5433
