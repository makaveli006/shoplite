{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignInToECR",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "PushImagesToShopLiteRepositoriesOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:<ACCOUNT_ID>:repository/shoplite/*"
    },
    {
      "Sid": "ReadAndRegisterTaskDefinitions",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition", "ecs:RegisterTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "UpdateShopLiteServices",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:us-east-1:<ACCOUNT_ID>:service/shoplite-cluster/*"
    },
    {
      "Sid": "RunTheMigrationTask",
      "Effect": "Allow",
      "Action": ["ecs:RunTask"],
      "Resource": "arn:aws:ecs:us-east-1:<ACCOUNT_ID>:task-definition/shoplite-migrate:*",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:us-east-1:<ACCOUNT_ID>:cluster/shoplite-cluster" }
      }
    },
    {
      "Sid": "WatchTheMigrationTask",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks"],
      "Resource": "arn:aws:ecs:us-east-1:<ACCOUNT_ID>:task/shoplite-cluster/*"
    },
    {
      "Sid": "HandTheShopLiteRolesToECS",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/shoplite-ecs-execution-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/shoplite-web-task-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/shoplite-worker-task-role"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    },
    {
      "Sid": "UploadTheReactApp",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<FRONTEND_BUCKET>/*"
    },
    {
      "Sid": "CompareTheReactAppFiles",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<FRONTEND_BUCKET>"
    }
  ]
}
