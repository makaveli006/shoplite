{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteProductPictures",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>/media/*"
    },
    {
      "Sid": "SeeWhichPicturesExist",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>"
    }
  ]
}
