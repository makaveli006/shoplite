{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProductPicturesForEmails",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>/media/*"
    },
    {
      "Sid": "SeeWhichPicturesExist",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<MEDIA_BUCKET>"
    }
  ]
}
