{
  "family": "shoplite-migrate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/shoplite-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "migrate",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/shoplite/web:<IMAGE_TAG>",
      "essential": true,
      "command": ["python", "manage.py", "migrate", "--noinput"],
      "environment": [
        { "name": "DJANGO_DEBUG", "value": "False" },
        { "name": "DB_NAME", "value": "shoplite" },
        { "name": "DB_USER", "value": "shoplite" },
        { "name": "DB_HOST", "value": "<DB_HOST>" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "DJANGO_SUPERUSER_USERNAME", "value": "admin" },
        { "name": "DJANGO_SUPERUSER_EMAIL", "value": "<ADMIN_EMAIL>" }
      ],
      "secrets": [
        { "name": "DJANGO_SECRET_KEY", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/shoplite/DJANGO_SECRET_KEY" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/shoplite/DB_PASSWORD" },
        { "name": "DJANGO_SUPERUSER_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/shoplite/DJANGO_SUPERUSER_PASSWORD" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shoplite-migrate",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "migrate"
        }
      }
    }
  ]
}
