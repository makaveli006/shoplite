# ---------- Secrets (never commit real credentials) ----------
.env
.env.*
!.env.example

# ---------- Python / uv ----------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---------- Django ----------
backend/media/
backend/email-previews/
backend/staticfiles/
*.sqlite3

# ---------- Node / Vite ----------
node_modules/
dist/
*.local

# ---------- Editors & operating system ----------
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Filled-in AWS policy copies (contain the account ID): never committed
deploy/aws/**/*.local.*

# Terraform: downloaded providers, state (records of real resources), and real variable values
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/backend.hcl
